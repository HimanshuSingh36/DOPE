# Contact form — pick ONE (either works, no backend needed)
# 1) Formspree (https://formspree.io — create a form, copy the ID from the URL)
VITE_FORMSPREE_ID=

# 2) Web3Forms (https://web3forms.com — paste your access key)
VITE_WEB3FORMS_KEY=

# AI — optional, for live LLM in the floating chat (App.jsx → AIChat) and AI Studio
# Leave blank to use instant mock mode (no key, no backend, no cost).
# Fill ONE of these for real streaming replies. Restart `npm run dev` after.
# ⚠️ Keys in VITE_ vars are exposed in the browser. For production, proxy via your server.
VITE_ANTHROPIC_API_KEY=
VITE_OPENAI_API_KEY=

# Copy this file to .env and fill what you need. Restart `npm run dev`.
